# Copy this file to .env.local and fill in the values.
# Never commit .env.local. The service-role key is a master key.
# It must stay on the server (seed script and hosting secrets only).
# The anon key is designed to be public. Row level security is what protects data.

# Local Supabase (after `supabase start`): run `npm run env:local`
# to fill these in from the local stack. Do not paste those local keys into a public site.

# From the Supabase dashboard: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API → service_role key. Server only. Not used by the website pages.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → Database → connection string (direct). Server only.
# Used by the local seed script. The seed script refuses any host that is not this computer.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
